# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# any .next* build dir, not just the two we happen to use today: Tailwind v4
# discovers its own content and skips whatever git ignores, so an un-ignored
# build directory gets scanned as source and mangled class names out of the
# compiled chunks reach globals.css ("Unexpected token Delim").
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local junk
*.stackdump
.playwright-mcp/
.code-review-graph/
.claude/
