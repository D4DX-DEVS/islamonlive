# Copy to .env.local and fill in. Nothing in the app hard-codes a domain —
# these variables decide which host serves the CMS and which one readers see.

# ---------------------------------------------------------------- the two hosts

# WordPress REST base. Server-side only: the browser never calls WordPress.
# Point this at the CMS host, NOT the public site — every canonical, OG tag and
# sitemap entry is rewritten off it, so getting it wrong is what makes Google
# index the backend.
WORDPRESS_API_URL=https://admin.islamonlive.in/wp-json/wp/v2

# WordPress origin, without the /wp-json path. Public because the image helpers
# that rewrite media hosts also run in client components. Safe to expose: it is
# a hostname, not a credential.
NEXT_PUBLIC_WORDPRESS_URL=https://admin.islamonlive.in

# The public site. Canonicals, structured data, share links and sitemaps are
# built from this.
NEXT_PUBLIC_SITE_URL=https://islamonlive.in

# ------------------------------------------------------------- cache refreshing

# Shared with the WordPress plugin (Settings -> Headless Frontend, or the
# IOL_REVALIDATION_SECRET constant in wp-config.php). WordPress sends it in the
# X-Revalidate-Secret header when it asks the site to refresh a page.
# Generate one with:  openssl rand -hex 32
# Server-side only. Never prefix this with NEXT_PUBLIC_.
REVALIDATION_SECRET=replace-with-a-secure-secret

# --------------------------------------------------------------- admin workspace
# Used only to sign the short-lived HTTP-only session that the Next admin page
# creates after validating the supplied WordPress login. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-different-secure-secret

# First-party reader analytics. The default NDJSON file is suitable for a
# persistent self-hosted volume; set an absolute path in production. The
# dashboard counts anonymous browser sessions and never stores an IP address.
ANALYTICS_STORE_PATH=.data/analytics.ndjson

# Optional GA4 Measurement Protocol forwarding. Leave blank to use the local
# analytics store only. Create an API secret in GA4 Admin -> Data Streams.
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ------------------------------------------------------------------- optional

# Web push (existing feature, unrelated to the WordPress migration)
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Build a production bundle beside a running dev server:  NEXT_DIST_DIR=.next-prod
# NEXT_DIST_DIR=

# ---------------------------------------------------------------------- staging
#
# A staging frontend reads the same WordPress. Point NEXT_PUBLIC_SITE_URL at the
# staging host so its canonicals are self-referencing rather than claiming to be
# production, and keep it out of the index with a separate robots policy.
#
#   NEXT_PUBLIC_SITE_URL=https://staging.islamonlive.in
#
# Before the admin. subdomain exists, both variables can still point at
# islamonlive.in. The config detects the shared host and disables the
# /wp-content and /wp-json proxying that would otherwise loop back on itself.

# Set to 1 only if Cloudflare's managed robots.txt stays switched on for the
# apex after the move: Cloudflare then injects the Content-Signal / AI-crawler
# block itself and this app leaves its own copy out. Read at build time.
ROBOTS_CLOUDFLARE_MANAGED=0

# Reader analytics storage. Leave unset locally (events go to .data/analytics.ndjson).
# On Vercel, connect an Upstash Redis database and set these (or the KV_REST_API_URL / KV_REST_API_TOKEN pair it injects):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
